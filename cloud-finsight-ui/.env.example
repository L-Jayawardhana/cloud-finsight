# Copy this file to .env before running `npm run dev` (only used by the host-run
# Vite dev server - the docker-compose build passes these as build args instead).
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=cloud-finsight
VITE_KEYCLOAK_CLIENT_ID=cloud-finsight-spa
VITE_API_BASE_URL=http://localhost:8080/api/v1
