{
  "realm": "cloud-finsight",
  "enabled": true,
  "sslRequired": "none",
  "accessCodeLifespan": 600,
  "roles": {
    "realm": [
      {
        "name": "viewer",
        "description": "Read-only access to dashboard and recommendation endpoints"
      },
      {
        "name": "admin",
        "description": "Full access, including destructive operations like deleting recommendations"
      }
    ]
  },
  "clients": [
    {
      "clientId": "cloud-finsight-api",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "secret": "dev-client-secret-change-me",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:8180/*"],
      "webOrigins": ["*"],
      "protocolMappers": [
        {
          "name": "audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "cloud-finsight-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "dashboard-user",
      "enabled": true,
      "emailVerified": true,
      "email": "dashboard-user@cloud-finsight.local",
      "firstName": "Dashboard",
      "lastName": "User",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "Password123!",
          "temporary": false
        }
      ],
      "realmRoles": ["viewer"]
    },
    {
      "username": "admin-user",
      "enabled": true,
      "emailVerified": true,
      "email": "admin-user@cloud-finsight.local",
      "firstName": "Admin",
      "lastName": "User",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "Password123!",
          "temporary": false
        }
      ],
      "realmRoles": ["admin"]
    }
  ]
}
