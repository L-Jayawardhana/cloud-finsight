# Copy this file to .env and fill in real values before running `docker compose up`.
# .env is gitignored - never commit it. See README.md for where to obtain each secret.

# --- PostgreSQL (shared by api-service, collector-service, and Keycloak) ---
POSTGRES_DB=finsight
POSTGRES_USER=finsight_user
POSTGRES_PASSWORD=changeme

# --- Redis (response caching) ---
REDIS_PASSWORD=changeme

# --- RabbitMQ (collector-service -> api-service recommendation messaging) ---
RABBITMQ_USER=finsight_user
RABBITMQ_PASSWORD=changeme

# --- Keycloak (authentication) ---
# Admin console login at http://localhost:8180 - pick any values, this just
# bootstraps the initial admin account on first startup.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=changeme

# --- Google Gemini (LLM-backed /explain and /chat endpoints in api-service) ---
# Get a free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=changeme

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
