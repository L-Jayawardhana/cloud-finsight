{
  "title": "Collector Pipeline Health",
  "uid": "collector-pipeline-health",
  "timezone": "browser",
  "refresh": "15s",
  "time": { "from": "now-6h", "to": "now" },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Analysis cycle duration (avg)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(collector_cycle_duration_seconds_sum{job=\"collector-service\", cycle=\"analysis\"}[5m]) / rate(collector_cycle_duration_seconds_count{job=\"collector-service\", cycle=\"analysis\"}[5m])",
          "legendFormat": "avg duration",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Recommendation engine runs/min",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(collector_cycle_duration_seconds_count{job=\"collector-service\", cycle=\"analysis\"}[5m]) * 60",
          "legendFormat": "runs/min",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Azure API calls (rate, by client/endpoint)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (client, endpoint) (rate(collector_azure_api_calls_total{job=\"collector-service\"}[5m]))",
          "legendFormat": "{{client}}/{{endpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Collector errors (rate, by source)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (source) (rate(collector_errors_total{job=\"collector-service\"}[5m]))",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "RabbitMQ queue depth",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rabbitmq_queue_messages{job=\"collector-service\"}",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Time since last engine run",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1800 },
              { "color": "red", "value": 3600 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "recommendation_engine_last_run_seconds_ago{job=\"collector-service\"}",
          "refId": "A"
        }
      ]
    }
  ]
}
